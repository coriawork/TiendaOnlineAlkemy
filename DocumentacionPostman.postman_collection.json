                        "key": "token",
                        "value": "{{jwt_token}}",
                        "type": "string"
                    }
                ]
            },
            "item": [
                {
                    "name": "Listar carritos",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "if (pm.response.code === 200) {",
                                    "    const json = pm.response.json();",
                                    "    const carritos = Array.isArray(json) ? json : (json.data || []);",
                                    "    const usuarioId = pm.collectionVariables.get('usuario_id');",
                                    "    const match = carritos.find(c => String(c.usuario_id) === String(usuarioId));",
                                    "    if (match) {",
                                    "        pm.collectionVariables.set('carrito_id', match.id);",
                                    "    }",
                                    "}"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [],
                        "description": "Devuelve el listado de carritos.",
